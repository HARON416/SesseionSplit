+// Copyright 2026 The SessionSplit Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the Chromium LICENSE file.
+
+#include "components/embedder_support/sessionsplit_profile_config.h"
+
+#include <algorithm>
+#include <utility>
+
+#include "base/i18n/language_tag.h"
+#include "base/i18n/tag_converters.h"
+#include "base/json/json_reader.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/values.h"
+#include "third_party/icu/source/common/unicode/unistr.h"
+#include "third_party/icu/source/i18n/unicode/timezone.h"
+
+namespace embedder_support {
+
+base::expected<SessionSplitProfileConfig, std::string>
+ParseSessionSplitProfileConfig(std::string_view json) {
+  if (json.empty() || json.size() > SessionSplitProfileConfig::kMaxBytes) {
+    return base::unexpected("Profile configuration exceeds the size limit");
+  }
+  auto dict = base::JSONReader::ReadDict(json, base::JSON_PARSE_RFC, 4);
+  if (!dict || dict->size() != 4) {
+    return base::unexpected("Profile configuration has invalid fields");
+  }
+  if (dict->FindInt("schemaVersion") !=
+      SessionSplitProfileConfig::kSchemaVersion) {
+    return base::unexpected("Unsupported profile configuration schemaVersion");
+  }
+
+  const std::string* seed = dict->FindString("seed");
+  if (!seed || seed->size() != 64 ||
+      !std::ranges::all_of(*seed, [](char c) {
+        return (c >= '0' && c <= '9') || (c >= 'a' && c <= 'f');
+      })) {
+    return base::unexpected("Profile seed must be 32 bytes of lowercase hex");
+  }
+  std::vector<uint8_t> bytes;
+  if (!base::HexStringToBytes(*seed, &bytes) || bytes.size() != 32) {
+    return base::unexpected("Invalid profile seed");
+  }
+
+  SessionSplitProfileConfig config;
+  std::ranges::copy(bytes, config.seed.begin());
+  const base::ListValue* languages = dict->FindList("languages");
+  if (!languages || languages->empty() || languages->size() > 8) {
+    return base::unexpected("Profile languages must contain one to eight tags");
+  }
+  for (const auto& value : *languages) {
+    const std::string* language = value.GetIfString();
+    if (!language || language->empty() || language->size() > 64) {
+      return base::unexpected("Invalid profile language tag");
+    }
+    auto tag = base::i18n::GetLanguageTagFromString(*language);
+    if (!tag) {
+      return base::unexpected("Invalid profile language tag");
+    }
+    std::string canonical(tag->tag_string());
+    if (std::ranges::find(config.languages, canonical) !=
+        config.languages.end()) {
+      return base::unexpected("Duplicate profile language tag");
+    }
+    config.languages.push_back(std::move(canonical));
+  }
+
+  const std::string* timezone = dict->FindString("timezone");
+  if (!timezone || timezone->empty() || timezone->size() > 128 ||
+      !std::ranges::all_of(*timezone,
+                          [](char c) { return c >= 0x21 && c <= 0x7e; })) {
+    return base::unexpected("Invalid profile timezone");
+  }
+  UErrorCode status = U_ZERO_ERROR;
+  UBool is_system_id = false;
+  icu::UnicodeString canonical;
+  icu::TimeZone::getCanonicalID(icu::UnicodeString::fromUTF8(*timezone),
+                              canonical, is_system_id, status);
+  if (U_FAILURE(status) || !is_system_id) {
+    return base::unexpected("Profile timezone must be a known system zone");
+  }
+  canonical.toUTF8String(config.timezone);
+  return config;
+}
+
+}  // namespace embedder_support
diff --git a/components/embedder_support/sessionsplit_profile_config.h b/components/embedder_support/sessionsplit_profile_config.h
new file mode 100644
--- /dev/null
+++ b/components/embedder_support/sessionsplit_profile_config.h
@@ -0,0 +1,38 @@
+// Copyright 2026 The SessionSplit Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the Chromium LICENSE file.
+
+#ifndef COMPONENTS_EMBEDDER_SUPPORT_SESSIONSPLIT_PROFILE_CONFIG_H_
+#define COMPONENTS_EMBEDDER_SUPPORT_SESSIONSPLIT_PROFILE_CONFIG_H_
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/component_export.h"
+#include "base/types/expected.h"
+
+namespace embedder_support {
+
+// Parsed startup data only. Ownership, process propagation, persistence, and
+// applying environment settings belong to the browser integration layer.
+struct SessionSplitProfileConfig {
+  static constexpr int kSchemaVersion = 1;
+  static constexpr std::size_t kMaxBytes = 16 * 1024;
+
+  std::array<uint8_t, 32> seed;
+  std::vector<std::string> languages;
+  std::string timezone;
+};
+
+// Errors name the invalid field without copying profile data into diagnostics.
+COMPONENT_EXPORT(SESSIONSPLIT_PROFILE_CONFIG)
+base::expected<SessionSplitProfileConfig, std::string>
+ParseSessionSplitProfileConfig(std::string_view json);
+
+}  // namespace embedder_support
+
+#endif  // COMPONENTS_EMBEDDER_SUPPORT_SESSIONSPLIT_PROFILE_CONFIG_H_
diff --git a/components/embedder_support/sessionsplit_profile_config_unittest.cc b/components/embedder_support/sessionsplit_profile_config_unittest.cc
new file mode 100644
--- /dev/null
+++ b/components/embedder_support/sessionsplit_profile_config_unittest.cc
@@ -0,0 +1,106 @@
+// Copyright 2026 The SessionSplit Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the Chromium LICENSE file.
+
+#include "components/embedder_support/sessionsplit_profile_config.h"
+
+#include <utility>
+
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace embedder_support {
+namespace {
+
+base::DictValue ValidInput() {
+  return base::JSONReader::ReadDict(
+             R"({"schemaVersion":1,
+                 "seed":"0101010101010101010101010101010101010101010101010101010101010101",
+                 "languages":["EN-us","en"],"timezone":"UTC"})",
+             base::JSON_PARSE_RFC)
+      .value();
+}
+
+auto Parse(base::DictValue dict) {
+  return ParseSessionSplitProfileConfig(base::WriteJson(dict).value());
+}
+
+TEST(SessionSplitProfileConfigTest, ParsesSeedAndCanonicalEnvironment) {
+  auto result = Parse(ValidInput());
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ(result->seed.front(), 1);
+  EXPECT_EQ(result->seed.back(), 1);
+  EXPECT_EQ(result->languages, (std::vector<std::string>{"en-US", "en"}));
+  EXPECT_EQ(result->timezone, "Etc/UTC");
+}
+
+TEST(SessionSplitProfileConfigTest, RejectsUnknownAndWronglyTypedVersions) {
+  auto dict = ValidInput();
+  dict.Set("schemaVersion", 2);
+  EXPECT_FALSE(Parse(std::move(dict)).has_value());
+  dict = ValidInput();
+  dict.Set("schemaVersion", "1");
+  EXPECT_FALSE(Parse(std::move(dict)).has_value());
+  dict = ValidInput();
+  dict.Set("schemaVersion", true);
+  EXPECT_FALSE(Parse(std::move(dict)).has_value());
+}
+
+TEST(SessionSplitProfileConfigTest, RejectsMissingAndUnknownFields) {
+  auto dict = ValidInput();
+  dict.Remove("timezone");
+  EXPECT_FALSE(Parse(std::move(dict)).has_value());
+  dict = ValidInput();
+  dict.Set("password", "must-not-enter-native-profile-config");
+  auto result = Parse(std::move(dict));
+  ASSERT_FALSE(result.has_value());
+  EXPECT_EQ(result.error().find("must-not-enter"), std::string::npos);
+}
+
+TEST(SessionSplitProfileConfigTest, RejectsInvalidSeedsWithoutEchoingInput) {
+  for (const auto& seed : {std::string(), std::string(63, 'a'),
+                           std::string(64, 'g'), std::string(64, 'A')}) {
+    auto dict = ValidInput();
+    dict.Set("seed", seed);
+    EXPECT_FALSE(Parse(std::move(dict)).has_value());
+  }
+}
+
+TEST(SessionSplitProfileConfigTest, RejectsInvalidAndDuplicateLanguages) {
+  for (const auto& json : {"[]", "[123]", "[\"not a language\"]",
+                           "[\"en-US\",\"EN-us\"]"}) {
+    auto dict = ValidInput();
+    dict.Set("languages", base::JSONReader::ReadList(json, base::JSON_PARSE_RFC)
+                              .value());
+    EXPECT_FALSE(Parse(std::move(dict)).has_value());
+  }
+  auto dict = ValidInput();
+  dict.Set("languages", "en-US");
+  EXPECT_FALSE(Parse(std::move(dict)).has_value());
+}
+
+TEST(SessionSplitProfileConfigTest, RejectsUnknownAndCustomOffsetTimezones) {
+  for (const auto* zone : {"Mars/Olympus", "GMT+03:00", "Africa/Nairobi\n"}) {
+    auto dict = ValidInput();
+    dict.Set("timezone", zone);
+    EXPECT_FALSE(Parse(std::move(dict)).has_value());
+  }
+  auto dict = ValidInput();
+  dict.Set("timezone", "Africa/Nairobi");
+  auto result = Parse(std::move(dict));
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ(result->timezone, "Africa/Nairobi");
+}
+
+TEST(SessionSplitProfileConfigTest, RejectsMalformedAndOversizedInput) {
+  EXPECT_FALSE(ParseSessionSplitProfileConfig("[]").has_value());
+  EXPECT_FALSE(ParseSessionSplitProfileConfig("{broken").has_value());
+  EXPECT_FALSE(ParseSessionSplitProfileConfig(
+                   std::string(SessionSplitProfileConfig::kMaxBytes + 1, ' '))
+                   .has_value());
+}
+
+}  // namespace
+}  // namespace embedder_support
